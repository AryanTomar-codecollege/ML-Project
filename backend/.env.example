# Choose one provider: groq or omniroute
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# OmniRoute
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto

# Model checkpoint created by the Colab training cell.
# Place best_wound_model_v2.pth in backend/models/
MODEL_PATH=models/best_wound_model_v2.pth
MAX_IMAGE_MB=10
MIN_CONFIDENCE=55
MIN_MARGIN=12
