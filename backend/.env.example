# Model: use your latest five-class checkpoint, not the old three-class file.
MODEL_PATH=models/best_wound_model_v2.pth

LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Or set LLM_PROVIDER=omniroute and configure these:
OMNIROUTE_API_KEY=
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto

MAX_IMAGE_MB=10
MIN_CONFIDENCE=55
MIN_MARGIN=12

RAG_ENABLED=true
RAG_DB_PATH=data/chroma
RAG_COLLECTION=first_aid_guidance
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_MIN_SCORE=0.25
